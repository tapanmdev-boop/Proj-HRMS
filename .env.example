# Copy to .env.local for local development.

# Base URL of the HRMS API (the backend's PORT + /api)
VITE_API_URL=http://localhost:3001/api

# Organization slug pre-filled on the sign-in page (optional)
VITE_DEFAULT_TENANT=

# Set to "true" to serve mock data through MSW instead of the real API (development only)
VITE_USE_MOCKS=false
