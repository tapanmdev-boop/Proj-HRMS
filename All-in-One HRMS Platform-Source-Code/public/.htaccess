# SPA fallback for the HRMS demo, deployed under /__-portfolio/hrms/
# Without this, refreshing or directly opening any in-app route
# (e.g. /__-portfolio/hrms/auth/login) returns a 404 from Apache,
# since those paths only exist client-side via React Router.

RewriteEngine On
RewriteBase /__-portfolio/hrms/

# Let real files/directories (JS, CSS, images, etc.) be served as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else falls back to index.html so React Router can handle it
RewriteRule ^ index.html [L]
